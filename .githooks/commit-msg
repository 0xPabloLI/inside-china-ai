#!/bin/bash
# =============================================================================
# commit-msg hook (version-controlled)
#
# Lives in .githooks/ and is activated via `git config core.hooksPath .githooks`
# (run `npm run setup:hooks` or `bash scripts/install-git-hooks.sh` after cloning;
#  both enable this hook and the strict registration gate).
#
# Check: Session-Id provenance gate (LOCAL GUARDRAIL, not a server-side rule).
#   Every commit that reaches this hook must carry exactly one Session-Id
#   trailer with a well-formed id (<yyyymmdd>-<task>-<6hex>), so parallel
#   sessions can associate work. With `session.provenance=strict` (set by the
#   installer) the id must also be registered; strict mode is fail-closed.
#
# Registration lookup (worktree-safe, both paths accepted):
#   1. $(git rev-parse --git-common-dir)/session-pilot/pilot-log.md  (canonical:
#      shared by every worktree, never committable)
#   2. .session-pilot/pilot-log.md at the worktree root (legacy, transition only)
#
# Paths that never reach this hook (measured, see scripts/test-commit-msg-hook.sh):
#   revert (no hook invocation at all), cherry-pick (keeps the ORIGINAL commit's
#   id, so the new commit is mis-attributed), commit-tree, git commit --no-verify,
#   and any checkout where hooksPath is not set.
#   Rules: use `revert --no-commit` and `cherry-pick --no-commit`, then commit
#   normally so the gate applies.
#   `git merge --no-ff` DOES reach this hook and is exempted by choice (below).
#
# Bypass (emergency only):  git commit --no-verify
# =============================================================================
set -u

MSG_FILE="$1"
if [ ! -f "$MSG_FILE" ]; then
  echo "[commit-msg] message file not found: $MSG_FILE" >&2
  exit 1
fi

# --- Merge exemption (deliberate) -------------------------------------------
# commit-msg DOES run for `git merge --no-ff` (measured on git 2.50.1), so this
# is a choice, not a platform limit: merge commits add no original work and
# blocking a routine merge/pull is worse than the attribution gap. Consequence:
# merge commits carry no Session-Id by design.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

# --- Extract Session-Id trailers -------------------------------------------
IDS=$(git interpret-trailers --parse < "$MSG_FILE" | grep -i '^Session-Id:' | sed 's/^[Ss]ession-[Ii]d:[[:space:]]*//' || true)
COUNT=$(printf '%s\n' "$IDS" | grep -c . || true)

fail() {
  echo ""
  echo "[commit-msg] BLOCKED: expected exactly 1 well-formed Session-Id trailer, $1"
  echo "Every commit that reaches this hook carries provenance so parallel sessions can associate work."
  echo ""
  echo "Repair:"
  echo "  1. If you don't have an id, generate one: <yyyymmdd>-<task>-<6hex>  (e.g. 20260903-refactor-a1b2c3)"
  echo "  2. Register it (registration failures print the exact file to edit)"
  echo "  3. Re-commit with: git commit --trailer \"Session-Id: <your-id>\""
  echo ""
  echo "Emergency bypass (discouraged): git commit --no-verify"
  echo ""
  exit 1
}

if [ "$COUNT" -eq 0 ]; then
  fail "found 0"
fi
if [ "$COUNT" -gt 1 ]; then
  fail "found $COUNT (amend stacking a second id makes both sessions unfindable)"
fi

ID=$(printf '%s\n' "$IDS" | head -1)
if ! printf '%s' "$ID" | grep -qE '^[0-9]{8}-[a-z0-9][a-z0-9-]*-[0-9a-f]{6}$'; then
  fail "malformed: \"$ID\" (expected <yyyymmdd>-<task>-<6hex>, e.g. 20260903-refactor-a1b2c3)"
fi

# --- Registration check (opt-in, fail-closed) -------------------------------
# Enabled by the installer: git config session.provenance strict
# When enabled an unregistered id is blocked, and a missing registry is a
# failure too — otherwise deleting the registry would silently switch the gate off.
if [ "$(git config --get session.provenance 2>/dev/null || echo '')" != "strict" ]; then
  exit 0
fi

COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null || echo "")
WORKTREE=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
REGISTRY="${COMMON_DIR:+$COMMON_DIR/session-pilot/pilot-log.md}"
LEGACY="${WORKTREE:+$WORKTREE/.session-pilot/pilot-log.md}"

FOUND=""
ANY_REGISTRY=""
for r in "$REGISTRY" "$LEGACY"; do
  [ -n "$r" ] || continue
  [ -f "$r" ] || continue
  ANY_REGISTRY="$r"
  # Token-exact match: the id must appear as a whole token, so a short id can
  # never satisfy itself by being a substring of a longer registered string.
  if grep -qE "(^|[^0-9A-Za-z-])${ID}(\$|[^0-9A-Za-z-])" "$r"; then
    FOUND="$r"
    break
  fi
done

# Legacy registry deprecation: common-dir is canonical; the worktree-root copy
# is a transition fallback scheduled for removal (see proposal §7.6). Two
# writable sources would drift, so using the legacy path warns every time.
if [ -n "$FOUND" ] && [ "$FOUND" = "$LEGACY" ] && [ -f "$REGISTRY" ]; then
  echo "[commit-msg] WARNING: id registered in legacy $LEGACY; canonical registry is $REGISTRY (legacy path is scheduled for removal)" >&2
fi

if [ -z "$FOUND" ]; then
  echo ""
  if [ -z "$ANY_REGISTRY" ]; then
    echo "[commit-msg] BLOCKED: strict mode is on but no registration file exists."
    echo "A trailer alone cannot map id -> session; registration is what makes work associable."
    echo ""
    echo "Repair:"
    echo "  1. mkdir -p \"${COMMON_DIR:-.git}/session-pilot\""
    echo "  2. Add an entry to \"${COMMON_DIR:-.git}/session-pilot/pilot-log.md\": Session-Id / tool / baseline / commits"
    echo "  3. Re-commit with the same trailer: git commit --trailer \"Session-Id: $ID\""
  else
    echo "[commit-msg] BLOCKED: Session-Id \"$ID\" is not registered."
    echo "Searched: ${REGISTRY}${LEGACY:+ and $LEGACY}"
    echo ""
    echo "Repair:"
    echo "  1. Add an entry to \"${REGISTRY:-$LEGACY}\": Session-Id / tool / baseline / commits"
    echo "  2. Re-commit with the same trailer: git commit --trailer \"Session-Id: $ID\""
  fi
  echo ""
  echo "Disable the registration gate: git config --unset session.provenance"
  echo "Emergency bypass (discouraged): git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
