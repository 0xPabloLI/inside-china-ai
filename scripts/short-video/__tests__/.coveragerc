# Python half of the repo coverage ratchet (#555 leftover).
#
# The JS half is vitest.config.ts. The metric differs — this side measures
# statements/lines, that side lines/statements/functions/branches — so the two
# floors stay separate numbers instead of one blend that means neither.
#
# Scope is "the modules this suite is responsible for". A module it does not
# cover is listed below with a reason instead of quietly diluting the number,
# and a new module in lib/ is measured by default (verified: an untested probe
# file shows up at 0% and drags the total down), so adding one either grows the
# tests or forces an explicit entry here. Caveat for future subdirectories:
# coverage's source walk names modules by path, so a file inside a
# non-identifier directory (the hyphen in b-roll/) is only reported once
# something imports it — such directories belong in omit anyway.

[run]
source = scripts/short-video/lib
# Keep the raw data file in the gitignored scratchpad (same territory as the
# JS side's .scratch/coverage) instead of dropping a .coverage in the repo root.
data_file = .scratch/coverage-python/.coverage
omit =
    # Resident ASR worker: NDJSON IPC driven by the node pipeline, needs the
    # whisper backends.
    scripts/short-video/lib/asr_worker.py
    # Runs in ~/.video-tts-env (funasr 1.4.14 + emotion2vec_plus_large).
    scripts/short-video/lib/emotion2vec_plugin.py
    # Has its own vitest IPC suite (focus_detector.test.mjs); needs cv2/PIL.
    scripts/short-video/lib/focus_detector.py
    # MLX / Ollama backends.
    scripts/short-video/lib/qwen38_vlm_wrapper.py
    # Manual probe scripts that happen to sit in lib/.
    scripts/short-video/lib/test_minicpm_*.py
    # B-roll: test_broll_warmup.py asserts the warmup planner's behaviour
    # (functional assertions on mlx_wan_batch's planning functions), while the
    # generator body needs MLX int8 weights and mlx_wan22_batch.py has no
    # assertions at all — measuring them would add a fixed tax on the total.
    scripts/short-video/lib/b-roll/*

[report]
# Ratchet, re-based 2026-10-14 (#555 leftover): 77.39% measured over the scope
# above — CI venv, 247 tests, asr_repetition_guard 90% / video_loader 93% /
# vlm_analyzer 68%. Under a stable scope, raise — never lower.
fail_under = 77
