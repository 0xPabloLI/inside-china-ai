{
  "description": "Golden fixture for focus_detector.py output schema validation.",
  "version": "2.0.0",
  "createdAt": "2026-11-13",
  "testImage": "scripts/short-video/assets/dh-fixtures/portrait-face.jpg",
  "expectedSchema": {
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "low_information", "degraded", "unsupported"]
    },
    "errorCode": { "type": "string|null" },
    "frame": {
      "type": "object|null",
      "fields": {
        "width": "number",
        "height": "number",
        "orientation": "string (landscape|portrait)",
        "orientationNormalized": "boolean"
      }
    },
    "protectedRegions": {
      "type": "array",
      "items": {
        "rect": "array<number> [x, y, w, h] (normalized 0-1)",
        "kind": "string",
        "confidence": "number|null (YuNet detector score)",
        "confidenceKind": "string (detector_score)"
      }
    },
    "saliency": {
      "type": "object",
      "fields": {
        "available": "boolean",
        "dispersion": "number (0-1)",
        "centroid": "array<number> [x, y] (normalized 0-1)"
      }
    }
  },
  "goldenCases": [
    {
      "name": "real-image-with-face",
      "input": "scripts/short-video/assets/dh-fixtures/portrait-face.jpg",
      "description": "Tracked real portrait (#396). YuNet must return the face with a detector score on the production interpreter; the previous fixture pointed at a shanghai-skyline.jpg that only existed inside content packs, so the suite skipped instead of catching a degraded production runtime.",
      "expectedStatus": "ok",
      "expectedErrorCode": null,
      "expectedFrameOrientation": "portrait",
      "expectedSaliencyAvailable": true,
      "minProtectedRegions": 1,
      "expectedConfidenceKind": "detector_score",
      "maxResponseTimeMs": 15000
    },
    {
      "name": "nonexistent-image-degraded",
      "input": "/tmp/nonexistent-focus-test.jpg",
      "expectedStatus": "degraded",
      "expectedErrorCode": "cannot_read_image",
      "expectedFrame": null,
      "expectedProtectedRegions": [],
      "expectedSaliencyAvailable": false,
      "maxResponseTimeMs": 500
    },
    {
      "name": "video-unsupported",
      "input": "/tmp/test-video.mp4",
      "expectedStatus": "unsupported",
      "expectedErrorCode": "video_not_supported",
      "maxResponseTimeMs": 100
    },
    {
      "name": "text-file-unsupported",
      "input": "/tmp/test.txt",
      "expectedStatus": "unsupported",
      "expectedErrorCode": "unsupported_media_type",
      "maxResponseTimeMs": 100
    }
  ]
}
