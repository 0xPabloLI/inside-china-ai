# =============================================================================
# .env — Public configuration (safe to commit, read by the web app)
# =============================================================================
# This file is committed to git. It contains only publishable keys and public
# URLs. Sensitive credentials go in .env.local (gitignored via *.local).
# Security model: Supabase RLS protects data, not key secrecy.

# --- Supabase (public/publishable keys — safe to expose) ---
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_URL="https://your-project-id.supabase.co"

# Vite-prefixed copies (required for client-side bundling)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# --- Short Video Pipeline: Cobalt (optional, for video download layer) ---
# Self-hosted Cobalt instance for downloading videos from 21+ platforms.
# Deploy: docker compose up -d (see ~/docker/docker-compose.yml)
# Docs: https://github.com/imputnet/cobalt/blob/main/docs/run-an-instance.md
# Leave unset to disable Cobalt adapter (pipeline will skip Cobalt strategy).
# Default Cobalt port is 9000 (not 3000).
# COBALT_API_URL="http://localhost:9000"
# COBALT_API_KEY=""  # Only if your instance has API key auth enabled

