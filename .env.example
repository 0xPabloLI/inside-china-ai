# =============================================================================
# .env — Public configuration (safe to commit, read by the web app)
# =============================================================================
# This file is committed to git. It contains only publishable keys and public
# URLs. Sensitive credentials go in .env.local (gitignored via *.local).
# Security model: Supabase RLS protects data, not key secrecy.

# --- Supabase (public/publishable keys — safe to expose) ---
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_URL="https://your-project-id.supabase.co"

# Vite-prefixed copies (required for client-side bundling)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
