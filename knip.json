{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "types"
  ],
  "ignore": [
    "src/integrations/supabase/types.ts",
    "src/lib/email-templates/**"
  ],
  "ignoreDependencies": [
    "@tanstack/router-plugin",
    "@remotion/effects",
    "@remotion/renderer"
  ],
  "ignoreBinaries": [
    "semgrep",
    "mcp-scanner",
    "osv-scanner",
    "kaggle",
    "rg",
    "ffmpeg",
    "ffprobe",
    "say",
    "nslookup",
    "colima",
    "yt-dlp"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/{router,server,start}.tsx",
        "src/{router,server,start}.ts",
        "src/routes/**/*.{ts,tsx}",
        "src/components/ui/**/*.{ts,tsx}",
        "src/hooks/*.tsx",
        "scripts/*.mjs",
        "scripts/article/*.mjs",
        "scripts/cloud-studio/*.mjs",
        "scripts/rag/*.mjs",
        "scripts/seo/**/*.mjs",
        "scripts/short-video/*.mjs",
        "scripts/short-video/lib/tiktok-csi.mjs",
        "scripts/short-video/lib/extract-media.mjs",
        "scripts/short-video/lib/b-roll/t2v-eval/score_eval.mjs",
        "scripts/short-video/__tests__/*.mjs",
        "scripts/short-video/evergreen-templates/*.mjs",
        "scripts/short-video/content/**/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "src/**/*.css",
        "scripts/**/*.{ts,tsx,mjs}"
      ]
    },
    "scripts/short-video/remotion": {
      "entry": ["remotion.config.ts", "src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      // CI runs `npm ci` at the root only; this package has its own lockfile, so
      // its node_modules is absent there and knip cannot resolve `react-dom`
      // (used by the Vite plugin graph, not by src) or the `remotion` binary's
      // providing package. Locally the workspace's node_modules does exist, so
      // both findings disappear — check edits here with it moved aside (#325).
      "ignoreDependencies": ["react-dom"],
      "ignoreBinaries": ["remotion"]
    }
  }
}
