# =============================================================================
# .env.local.example — Sensitive credentials template (DO NOT commit the real .env.local)
# =============================================================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored via *.local in .gitignore.
# Never commit real credentials to git.

# =============================================================================
# Web App Admin (required for article publishing scripts)
# =============================================================================
SUPABASE_REFRESH_TOKEN="your-refresh-token"
ADMIN_EMAIL="your-admin@email.com"
ADMIN_PASSWORD="your-admin-password"

# =============================================================================
# TTS / Digital Human APIs (optional — only for video pipeline)
# =============================================================================
# HeyGen — digital human video generation
HEYGEN_API_KEY="sk_your_key_here"

# D-ID — talking head generation
DID_API_KEY="your_key_here"

# HuggingFace — model downloads (e.g. F5-TTS, whisperx)
HF_TOKEN="hf_your_token_here"

# =============================================================================
# Cloud GPU (optional — only for remote GPU tasks)
# =============================================================================
# Lightning AI — free GPU cloud (L4 24GB, A100 80GB)
LIGHTNING_USER_ID="your-user-id"
LIGHTNING_API_KEY="your-api-key"

# =============================================================================
# Stock Media APIs (optional — only for asset-sourcer.mjs)
# =============================================================================
PEXELS_API_KEY="your_key_here"
UNSPLASH_ACCESS_KEY="your_key_here"
UNSPLASH_APP_ID="your_app_id"
PIXABAY_API_KEY="your_key_here"
COVERR_API_KEY="your_key_here"

# =============================================================================
# Social Media Publishing (optional — only for publish-tiktok.mjs)
# =============================================================================
# ScrapeCreators — TikTok/Instagram data (credits-based, 10k free calls)
# Also used by source-registry.mjs for tiktok_creator apiSearch (keyword search)
SCRAPECREATORS_API_KEY="your_key_here"

# Apify — TikTok data scraping (hashtag views/posts, competitor analysis)
# Free plan: $5/month credit. Used by analytics-workflow.md → Hashtag 库维护.
# Reference impl: docs/refs/tiktok-skills/lib/apify_client.py
APIFY_TOKEN="apify_api_your_token_here"

# Publora — TikTok publishing service (configured via MCP, not env var)
# PUBLORA_API_KEY="sk_your_key_here"

# =============================================================================
# Search Source APIs (optional — used by source-registry.mjs apiSearch layer)
# =============================================================================
# GitHub — increases rate limit from 60 to 5000 req/hour for github_search source
# Generate at: GitHub Settings → Developer settings → Personal access tokens → Fine-grained tokens
# GITHUB_TOKEN="ghp_your_token_here"

# =============================================================================
# TTS Engine Tuning (optional — defaults are sensible)
# =============================================================================
# TTS_ENGINE="cosyvoice3-mlx"  # Options: cosyvoice3-mlx, f5-mlx, qwen, edge-tts, say
# TTS_ATEMPO="1.0"              # Audio tempo adjustment
# TTS_HIGHPASS="80"             # Highpass filter frequency (Hz)
# TTS_DENOISE="5"               # FFmpeg afftdn noise reduction strength
# TTS_NO_LOUDNORM="0"           # Set to "1" to skip loudness normalization

# CosyVoice3-Kaggle-CUDA specific (DEFAULT engine — P100 GPU, full emotion fidelity)
# Requires: Kaggle CLI installed + ~/.kaggle/kaggle.json configured
# COSYVOICE3_KAGGLE_SLUG="cosyvoice3-cuda-batch"
# COSYVOICE3_KAGGLE_USER=""          # auto-detected from ~/.kaggle/kaggle.json if empty
# COSYVOICE3_KAGGLE_TIMEOUT_MS="1200000"  # 20 min default

# CosyVoice3-MLX specific (LOCAL FALLBACK engine — emotion regression vs CUDA)
# COSYVOICE3_MLX_MODEL_DIR="$HOME/.cosyvoice3-mlx-model"
# COSYVOICE3_SPEED="1.0"

# F5-TTS-MLX specific (BACKUP engine)
# F5_SPEED="1.0"

# Qwen3-TTS specific
# QWEN_TTS_MODEL_DIR="$HOME/.qwen-tts-model"
# QWEN_TTS_LANGUAGE="English"
